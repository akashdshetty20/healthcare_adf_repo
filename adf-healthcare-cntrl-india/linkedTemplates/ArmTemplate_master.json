{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-healthcare-cntrl-india"
		},
		"LS_ADLS_adlshealthcarecntrlindia_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlshealthcarecntrlindia.dfs.core.windows.net/"
		},
		"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1107-180136-c891osrf"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "healthcare-azure-sql-server.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-healthcare"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "healthcare"
		},
		"LS_PostgreSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-red-sky-b4hwlmgr-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"LS_PostgreSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSQL_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"kv_healthcarecntrlindia_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvhealthcarecntrlindia.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-healthcare-cntrl-india_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_adlshealthcarecntrlindia_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_adlshealthcarecntrlindia_properties_typeProperties_url')]"
					},
					"kv_healthcarecntrlindia_properties_typeProperties_baseUrl": {
						"value": "[parameters('kv_healthcarecntrlindia_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"LS_AzureSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_userName')]"
					},
					"LS_PostgreSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSQL_properties_typeProperties_server')]"
					},
					"LS_PostgreSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSQL_properties_typeProperties_database')]"
					},
					"LS_PostgreSQL_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSQL_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}